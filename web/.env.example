# Copy to .env.local for local dev; set the same vars in Vercel's dashboard.
# Both are safe for the browser: the anon key is gated by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Timezone for rendering timestamps (IANA name).
NEXT_PUBLIC_TIMEZONE=America/New_York

# OPTIONAL, server-only (note the missing NEXT_PUBLIC_ prefix -- never expose
# this to the browser). Enables "Create a new admin account" on /admins.
# Without it, create accounts in the Supabase dashboard and grant access by
# email instead. This key bypasses Row Level Security, so only set it if you
# want that convenience.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
